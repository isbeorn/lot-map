{
  "name": "lot-map",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .ts,.tsx hooks types",
    "typecheck": "tsc --noEmit -p .claude-plugin/types/tsconfig.json",
    "format": "prettier --write \"{hooks,types}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{hooks,types}/**/*.{ts,tsx}\"",
    "test": "claude plugin test ."
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@typescript-eslint/eslint-plugin": "8.34.0",
    "@typescript-eslint/parser": "8.34.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  }
}
